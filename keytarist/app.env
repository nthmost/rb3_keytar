# Per-app build configuration. Sourced by scripts/build.sh.
# These values are set by new-app.sh at scaffold time; edit freely afterward.

APP_NAME="Keytarist"
BUNDLE_ID="net.nthmost.keytarist"

# true  => menu-bar-only app: no Dock icon, no app-switcher entry (LSUIElement)
# false => normal Dock app (use this even for "both" — a menu bar item still shows)
MENUBAR_ONLY="false"

# Bumped manually or by your release process.
VERSION="1.0"
BUILD="1"
